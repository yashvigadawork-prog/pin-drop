# Copy these names into Vercel: Project, Settings, Environment Variables.
# Never put real values in this file or commit them.

# AI chat (free keys from https://aistudio.google.com/apikey). The app tries them in order.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Saved runs and shareable links. Added automatically when you connect a Neon database in Vercel.
POSTGRES_URL=

# "Real send" for demos: every email goes to ONE test inbox, never to an applicant.
RESEND_API_KEY=
TEST_INBOX=
MAIL_FROM=
